# Copy to .env to override defaults. Used by docker-compose and the API.

# Postgres (index)
POSTGRES_USER=aicontrol
POSTGRES_PASSWORD=aicontrol
POSTGRES_DB=aicontrol
POSTGRES_PORT=5442
DATABASE_URL=postgresql+psycopg://aicontrol:aicontrol@localhost:5442/aicontrol

# Web UI (web/): origins allowed to call the JSON API from a browser, as a JSON list.
# Default: the Vite dev server (5173) and `vite preview` (4173). Change it if the UI runs elsewhere.
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]

# S3-compatible storage (full traces). Local default: MinIO.
# AWS S3: leave S3_ENDPOINT_URL empty and set S3_REGION.
# GCS:    S3_ENDPOINT_URL=https://storage.googleapis.com with HMAC keys.
S3_ENDPOINT_URL=http://localhost:9100
S3_BUCKET=aicontrol-traces
S3_ACCESS_KEY=aicontrol
S3_SECRET_KEY=aicontrol-secret
S3_REGION=us-east-1
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101

# End-to-end tests (real OpenAI API, no mocks): uv run pytest -m e2e  (in sdk/ and api/)
# OPENAI_API_KEY=sk-...   # put your real key in .env (git-ignored), never here
AICONTROL_E2E_MODEL=gpt-4o-mini
# Optional: run the e2e tests against an OpenAI-compatible server instead (e.g. Ollama)
# AICONTROL_E2E_BASE_URL=http://localhost:11434/v1
